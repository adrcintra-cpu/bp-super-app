<dialog class="app-dialog" data-app-dialog aria-labelledby="app-dialog-title">
  <form class="app-dialog-card" data-dialog-form method="dialog">
    <div class="app-dialog-head"><div><p class="eyebrow" data-dialog-eyebrow>ATUALIZAÇÃO</p><h2 id="app-dialog-title" data-dialog-title>Informações</h2></div><button class="icon-button" type="button" data-dialog-close aria-label="Fechar"><img src="/icons/x.svg" alt="" /></button></div>
    <p class="app-dialog-description" data-dialog-description></p>
    <div class="app-dialog-fields" data-dialog-fields></div>
    <div class="app-dialog-actions"><button class="button button-ghost" type="button" data-dialog-cancel>Cancelar</button><button class="button button-primary" type="submit" data-dialog-submit>Salvar</button></div>
  </form>
</dialog>
<div class="toast" data-toast-box role="status" aria-live="polite"><img src="/icons/check-circle.svg" alt="" /><span>Ação concluída</span></div>
