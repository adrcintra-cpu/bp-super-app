  <script type="application/json" data-mock-data set:html={JSON.stringify(mockAppData)}></script>
  <script is:inline>
    const mockData = JSON.parse(document.querySelector('[data-mock-data]')?.textContent || '{}');
    const screens = [...document.querySelectorAll('[data-screen]')];
    const routeButtons = [...document.querySelectorAll('[data-route]')];
    const drawer = document.querySelector('[data-drawer]');
    const productMenu = document.querySelector('[data-product-menu]');
    const toast = document.querySelector('[data-toast-box]');
    const login = document.querySelector('[data-login]');
    const protectedSurfaces = [...document.querySelectorAll('.sidebar,.app-main,.bottom-nav')];
    const individualRoutes = new Set(['inicio', 'cadastro', 'avisos', 'plano', 'carteirinha', 'financeiro', 'bommed', 'instituto']);
    let isAuthenticated = sessionStorage.getItem('bp-master-authenticated') === 'true';
    let toastTimer;
    function showToast(message) { toast.querySelector('span').textContent = message; toast.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.remove('show'), 2600); }
    const normalizeText = value => String(value ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('pt-BR').trim();
    const today = new Date();
    const monthsShort = ['JAN', 'FEV', 'MAR', 'ABR', 'MAI', 'JUN', 'JUL', 'AGO', 'SET', 'OUT', 'NOV', 'DEZ'];
    const shortDate = date => `${String(date.getDate()).padStart(2, '0')} ${monthsShort[date.getMonth()]}`;
    const todayLabelEl = document.querySelector('[data-today-label]');
    if (todayLabelEl) todayLabelEl.textContent = today.toLocaleDateString('pt-BR', { weekday: 'long', day: 'numeric', month: 'long' }).replace(/^./, c => c.toUpperCase()).toLocaleUpperCase('pt-BR');
    const dueIso = mockData.billing?.current?.dueDateISO;
    if (dueIso) {
      const [y, m, d] = dueIso.split('-').map(Number);
      const startOfToday = new Date(today.getFullYear(), today.getMonth(), today.getDate());
      const days = Math.round((new Date(y, m - 1, d) - startOfToday) / 86400000);
      const when = days > 1 ? `em ${days} dias` : days === 1 ? 'amanhã' : days === 0 ? 'hoje' : `há ${Math.abs(days)} dia${days === -1 ? '' : 's'}`;
      document.querySelectorAll('[data-due-text]').forEach(el => { el.textContent = el.dataset.dueText.replace('{n}', when); });
    }
    const onlyDigits = value => String(value ?? '').replace(/\D/g, '');
    const maskCpf = value => onlyDigits(value).slice(0, 11).replace(/^(\d{3})(\d)/, '$1.$2').replace(/^(\d{3})\.(\d{3})(\d)/, '$1.$2.$3').replace(/\.(\d{3})(\d{1,2})$/, '.$1-$2');
    const isValidCpf = value => {
      const cpf = onlyDigits(value);
      if (cpf.length !== 11 || /^(\d)\1{10}$/.test(cpf)) return false;
      const digit = len => { let sum = 0; for (let i = 0; i < len; i += 1) sum += Number(cpf[i]) * (len + 1 - i); const rest = (sum * 10) % 11; return rest === 10 ? 0 : rest; };
      return digit(9) === Number(cpf[9]) && digit(10) === Number(cpf[10]);
    };
    const maskDate = value => onlyDigits(value).slice(0, 8).replace(/^(\d{2})(\d)/, '$1/$2').replace(/^(\d{2})\/(\d{2})(\d)/, '$1/$2/$3');
    const parseBirthDate = value => {
      const match = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(value || ''); if (!match) return null;
      const [, d, m, y] = match.map(Number); const date = new Date(y, m - 1, d);
      if (date.getFullYear() !== y || date.getMonth() !== m - 1 || date.getDate() !== d) return null;
      if (y < 1900 || date > today) return null;
      return date;
    };
    const maskPhone = value => { const digits = onlyDigits(value).slice(0, 11); if (digits.length <= 10) return digits.replace(/^(\d{2})(\d)/, '($1) $2').replace(/(\d{4})(\d{1,4})$/, '$1-$2'); return digits.replace(/^(\d{2})(\d{5})(\d{0,4})$/, '($1) $2-$3'); };
    const isValidPhone = value => /^\d{10,11}$/.test(onlyDigits(value)) && Number(onlyDigits(value).slice(0, 2)) >= 11;
    const escapeHtml = value => String(value ?? '').replace(/[&<>'"]/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]);
    const appDialog = document.querySelector('[data-app-dialog]');
    const dialogForm = appDialog.querySelector('[data-dialog-form]');
    const dialogFields = appDialog.querySelector('[data-dialog-fields]');
    let dialogSubmitHandler = null;
    let dialogLastFocus = null;
    const closeDialog = () => { if (appDialog.open) appDialog.close(); };
    const openDialog = ({ eyebrow = 'ATUALIZAÇÃO', title, description = '', fields = '', submitLabel = 'Salvar', onSubmit, hideCancel = false, onOpen }) => {
      dialogLastFocus = document.activeElement;
      appDialog.querySelector('[data-dialog-eyebrow]').textContent = eyebrow;
