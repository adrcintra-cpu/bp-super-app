---
import Layout from "../layouts/Layout.astro";
import FeedbackLayer from "../components/FeedbackLayer.astro";
import Login from "../components/Login.astro";
import "../styles/app.css";
import { mockAppData } from "../data/mockData.js";

const { customer, plan, beneficiaries, billing, communications, guides, guideCatalog } = mockAppData;
const unreadMessages = communications.filter((message) => message.unread).length;
const navItems = [
  { id: "inicio", label: "Início", icon: "home" },
  { id: "cadastro", label: "Meu cadastro", icon: "user" },
  { id: "avisos", label: "Comunicação", icon: "bell", badge: String(unreadMessages) },
  { id: "plano", label: "Plano e contrato", icon: "file-text" },
  { id: "carteirinha", label: "Carteirinha", icon: "credit-card" },
  { id: "financeiro", label: "Financeiro", icon: "wallet" },
  { id: "bommed", label: "Minhas Guias", icon: "heart-pulse" },
  { id: "instituto", label: "Instituto do Luto", icon: "heart-handshake" },
];

const shortcuts = [
  { id: "bommed", title: "Gerar guia", text: "Atendimento com até 35% de desconto", icon: "heart-pulse", tone: "blue featured" },
  { id: "financeiro", title: "2ª via e Pix", text: `Vencimento em ${billing.current.daysUntilDue} dias`, dueDays: true, icon: "wallet", tone: "orange" },
  { id: "plano", title: "Meu plano", text: "Contrato e dependentes", icon: "file-text", tone: "purple" },
  { id: "instituto", title: "Pedir apoio", text: "Atendimento confidencial", icon: "heart-handshake", tone: "support-highlight" },
];
---

<Layout title="Super App Bom Pastor | Área do Cliente" description="Acesse seu plano, financeiro, benefícios e serviços do Grupo Bom Pastor.">
  <div class="app-shell" data-app>
    <aside class="sidebar" aria-label="Navegação principal">
      <a class="brand" href="#inicio" data-route="inicio" aria-label="Grupo Bom Pastor - Início">
        <img class="brand-logo" src="/logos/bompastor-logo.svg" alt="Grupo Bom Pastor" />
      </a>
      <nav class="side-nav">
        <p class="nav-eyebrow">Sua área</p>
        {navItems.map((item) => (
          <button class:list={["nav-item", { active: item.id === "inicio" }]} data-route={item.id} type="button">
            <img src={`/icons/${item.icon}.svg`} alt="" />
            <span>{item.label}</span>
            {item.badge && <span class="nav-badge">{item.badge}</span>}
          </button>
        ))}
      </nav>
      <button class="sidebar-help" type="button" data-route="instituto">
        <span class="help-icon"><img src="/icons/phone.svg" alt="" /></span>
        <div><small>Precisa de ajuda?</small><strong>Fale com a gente</strong></div>
        <img class="help-arrow" src="/icons/chevron-right.svg" alt="" />
      </button>
    </aside>

    <div class="app-main">
      <header class="topbar">
        <button class="menu-button" type="button" aria-label="Abrir menu" data-menu-open><img src="/logos/bompastor-logo-minimalista.svg" alt="Bom Pastor" /></button>
        <div class="top-actions">
          <button class="header-search" type="button" data-search-button aria-label="Buscar no aplicativo"><img src="/icons/search.svg" alt="" /></button>
          <button class="profile-button" type="button" data-profile-button aria-expanded="false">
            <span class="avatar-shell"><span class="avatar">{customer.initials}</span><i aria-label={`${unreadMessages} comunicados não lidos`}>{unreadMessages}</i></span><span class="profile-copy"><small>Bem-vindo,</small><strong>{customer.name}</strong></span><img src="/icons/chevron-right.svg" alt="" />
          </button>
        </div>
        <div class="global-search" data-global-search hidden>
          <label><img src="/icons/search.svg" alt="" /><input type="search" placeholder="Buscar serviço, guia ou informação" autofocus /></label>
          <button type="button" data-search-close aria-label="Fechar busca"><img src="/icons/x.svg" alt="" /></button>
          <div class="global-search-results" data-search-results hidden aria-label="Resultados da busca"></div>
        </div>
        <button class="accessibility-backdrop" type="button" data-accessibility-backdrop aria-label="Fechar opções de acessibilidade" hidden></button>
        <section class="accessibility-panel" id="accessibility-panel" data-accessibility-panel role="dialog" aria-modal="true" aria-labelledby="accessibility-title" hidden>
          <div class="accessibility-head"><div><p class="eyebrow">ACESSIBILIDADE</p><h2 id="accessibility-title">Acessibilidade</h2></div><button class="icon-button" type="button" data-accessibility-close aria-label="Fechar opções de acessibilidade"><img src="/icons/x.svg" alt="" /></button></div>
          <p class="accessibility-description">Ajuste a visualização para deixar sua experiência mais confortável.</p>
          <div class="accessibility-section"><h3>Tamanho do texto</h3><div class="font-scale-controls" role="group" aria-label="Ajustar tamanho do texto"><button type="button" data-font-action="decrease" aria-label="Diminuir texto">A−</button><button type="button" data-font-action="default" aria-label="Usar tamanho padrão">A</button><button type="button" data-font-action="increase" aria-label="Aumentar texto">A+</button></div><p class="font-scale-status" data-font-scale-status aria-live="polite">Tamanho padrão</p></div>
          <button class="button button-ghost accessibility-reset" type="button" data-font-reset>Restaurar padrão</button>
        </section>
        <div class="profile-popover" data-profile-popover hidden>
          <div><strong>{customer.name}</strong><small>Titular • {plan.name}</small></div>
          <button type="button" data-route="cadastro"><img src="/icons/user.svg" alt="" /> Meu cadastro</button>
          <button type="button" data-route="avisos"><img src="/icons/bell.svg" alt="" /> Comunicação <span class="profile-menu-badge" aria-label={`${unreadMessages} comunicados não lidos`}>{unreadMessages}</span></button>
          <button class="profile-accessibility-button" type="button" data-accessibility-button aria-label="Opções de acessibilidade" aria-expanded="false" aria-controls="accessibility-panel"><img src="/icons/accessibility.svg" alt="" /> Acessibilidade</button>
          <button type="button" data-show-login><img src="/icons/log-out.svg" alt="" /> Sair da conta</button>
        </div>
      </header>

      <nav class="product-menu product-strip" data-product-menu aria-label="Principais produtos">
        <a class="product-item pet" href="https://grupobompastor.com.br/bompet/" target="_blank" rel="noopener noreferrer" aria-label="BomPet — abre em nova aba"><span><img src="/icons/dog.svg" alt="" /></span><small>BomPet</small></a>
        <button class="product-item med" type="button" data-route="bommed"><span><img src="/icons/heart-pulse.svg" alt="" /></span><small>BomMed</small></button>
        <a class="product-item auto" href="https://grupobompastor.com.br/bomauto/" target="_blank" rel="noopener noreferrer" aria-label="BomAuto — abre em nova aba"><span><img src="/icons/car.svg" alt="" /></span><small>BomAuto</small></a>
        <a class="product-item corp" href="https://grupobompastor.com.br/plano-bomcorp/" target="_blank" rel="noopener noreferrer" aria-label="BomCorp — abre em nova aba"><span><img src="/icons/building-2.svg" alt="" /></span><small>BomCorp</small></a>
        <a class="product-item descanso desktop-product" href="https://grupobompastor.com.br/bomdescanso/" target="_blank" rel="noopener noreferrer" aria-label="BomDescanso — abre em nova aba"><span><img src="/icons/moon.svg" alt="" /></span><small>BomDescanso</small></a>
        <a class="product-item cremacao desktop-product" href="https://grupobompastor.com.br/cremacao/" target="_blank" rel="noopener noreferrer" aria-label="Cremação — abre em nova aba"><span><img src="/icons/urn.svg" alt="" /></span><small>Cremação</small></a>
      </nav>

      <main class="content" id="conteudo">
        <section class="screen active" data-screen="inicio" aria-labelledby="inicio-title">
          <div class="page-intro intro-home">
            <div><p class="eyebrow" data-today-label>&nbsp;</p><h1 id="inicio-title">Olá, <strong>{customer.firstName}.</strong><br />Tudo bem por aí?</h1><p class="intro-text">Seu plano e seus serviços, organizados em um só lugar.</p></div>
            <span class="status-pill"><i></i> Plano ativo</span>
          </div>

          <article class="hero-card reveal">
            <div class="hero-orb orb-one"></div><div class="hero-orb orb-two"></div>
            <div class="hero-content"><p class="eyebrow light">SEU PLANO</p><h2>TOTAL<span>+</span></h2><p>Proteção para você e sua família, todos os dias.</p><button class="button button-light" type="button" data-route="plano">Ver detalhes <span>→</span></button></div>
            <div class="digital-card" aria-label="Carteirinha digital">
              <div class="card-brand"><img class="card-logo" src="/logos/bompastor-logo.svg" alt="Grupo Bom Pastor" /></div><img class="card-watermark" src="/logos/bompastor-logo-minimalista.svg" alt="" aria-hidden="true" /><span class="card-chip"></span><div><small>TITULAR</small><strong>FERNANDO ERNERTO</strong></div>
              <div class="card-meta"><span><small>PLANO</small><strong>{plan.name}</strong></span><span><small>CARTEIRINHA</small><strong>{plan.cardNumber}</strong></span></div>
            </div>
          </article>

          <section class="section-block">
            <div class="section-heading"><div><p class="eyebrow">ACESSO RÁPIDO</p><h2>O que você precisa hoje?</h2></div></div>
            <div class="shortcut-grid">
              {shortcuts.map((item, index) => (
                <button class={`shortcut-card ${item.tone} reveal`} style={`--delay:${index * 70}ms`} type="button" data-route={item.id}>
                  <span class="shortcut-icon"><img src={`/icons/${item.icon}.svg`} alt="" /></span><span class="shortcut-copy"><strong>{item.title}</strong><small {...(item.dueDays ? { "data-due-text": "Vencimento {n}" } : {})}>{item.text}</small></span><img class="shortcut-arrow" src="/icons/chevron-right.svg" alt="" />
                </button>
              ))}
            </div>
          </section>

          <div class="dashboard-grid">
            <article class="panel finance-summary reveal">
              <div class="panel-title"><div><p class="eyebrow">FINANCEIRO</p><h3>Próxima mensalidade</h3></div><span class="soft-badge warning">Em aberto</span></div>
              <div class="invoice-value"><div><small>VENCIMENTO</small><strong>{billing.current.dueShort}</strong></div><div><small>VALOR</small><strong>{billing.current.amount}</strong></div></div><div class="progress"><span style="width:72%"></span></div>
              <button class="text-link" type="button" data-route="financeiro">Ver opções de pagamento <span>→</span></button>
            </article>
            <article class="panel notice-summary reveal">
              <div class="panel-title"><div><p class="eyebrow">COMUNICAÇÃO</p><h3>Avisos recentes</h3></div><button class="text-link compact" type="button" data-route="avisos">Ver todos</button></div>
              <ul class="mini-list"><li><span class="list-icon orange"><img src="/icons/wallet.svg" alt="" /></span><div><strong>Boleto disponível</strong><small data-due-text="Sua mensalidade vence {n}.">Sua mensalidade vence em {billing.current.daysUntilDue} dias.</small></div><time>há 2h</time></li><li><span class="list-icon blue"><img src="/icons/heart-pulse.svg" alt="" /></span><div><strong>Nova guia autorizada</strong><small>Disponível para visualização.</small></div><time>ontem</time></li></ul>
            </article>
          </div>
        </section>

        <section class="screen" data-screen="bomcorp" aria-labelledby="bomcorp-title">
          <div class="page-intro"><div><p class="eyebrow">BOM CORP</p><h1 id="bomcorp-title">Painel do <strong>gestor</strong></h1><p class="intro-text">Visão geral dos colaboradores, planos e pendências da empresa.</p></div><button class="button button-primary" type="button" data-add-collaborator>+ Adicionar colaborador</button></div>
          <div class="metric-grid"><article class="metric-card gradient-blue"><span><img src="/icons/users.svg" alt="" /></span><small>Colaboradores ativos</small><strong data-collaborator-count>248</strong><em>+8 este mês</em></article><article class="metric-card gradient-purple"><span><img src="/icons/user.svg" alt="" /></span><small>Dependentes</small><strong>12</strong><em>no mês</em></article><article class="metric-card gradient-orange"><span><img src="/icons/wallet.svg" alt="" /></span><small>Faturamento atual</small><strong>R$ 38.420</strong><em>vence dia 10</em></article><article class="metric-card gradient-blue"><span><img src="/icons/clock.svg" alt="" /></span><small>Pendências</small><strong>3</strong><em>aguardando ação</em></article></div>
          <article class="panel data-panel"><div class="panel-title"><div><p class="eyebrow">GESTÃO DE VIDAS</p><h3>Colaboradores</h3></div><label class="search-field"><img src="/icons/search.svg" alt="" /><input type="search" placeholder="Buscar colaborador" data-collaborator-search /></label></div><div class="table-wrap"><table><thead><tr><th>Colaborador</th><th>CPF</th><th>Plano</th><th>Status</th><th></th></tr></thead><tbody data-collaborator-list><tr><td><span class="person"><b>AS</b><span><strong>Ana Souza</strong><small>ana@empresa.com</small></span></span></td><td>123.***.***-00</td><td>BomMed +</td><td><span class="soft-badge success">Ativo</span></td><td><button class="row-action" type="button" data-collaborator-action aria-label="Opções de Ana Souza">⋯</button></td></tr><tr><td><span class="person"><b>CM</b><span><strong>Carlos Mendes</strong><small>carlos@empresa.com</small></span></span></td><td>456.***.***-00</td><td>BomPet</td><td><span class="soft-badge success">Ativo</span></td><td><button class="row-action" type="button" data-collaborator-action aria-label="Opções de Carlos Mendes">⋯</button></td></tr><tr><td><span class="person"><b>JR</b><span><strong>Júlia Rocha</strong><small>julia@empresa.com</small></span></span></td><td>789.***.***-00</td><td>BomAuto</td><td><span class="soft-badge warning">Pendente</span></td><td><button class="row-action" type="button" data-collaborator-action aria-label="Opções de Júlia Rocha">⋯</button></td></tr></tbody></table><p class="table-empty" data-collaborator-empty hidden>Nenhum colaborador encontrado.</p></div></article>
        </section>

        <section class="screen" data-screen="cadastro" aria-labelledby="cadastro-title">
          <div class="page-intro"><div><button class="page-back" type="button" data-route="inicio"><span aria-hidden="true">←</span> Voltar ao início</button><p class="eyebrow">MINHA CONTA</p><h1 id="cadastro-title">Dados <strong>cadastrais</strong></h1><p class="intro-text">Mantenha seus dados atualizados para receber todos os comunicados.</p></div><span class="status-pill"><i></i> Cadastro verificado</span></div>
          <div class="form-layout">
            <aside class="profile-card panel">
              <div class="profile-photo-wrap">
                <span class="large-avatar" data-profile-photo-preview aria-label="Foto de perfil de Fernando Ernerto">FE</span>
                <label class="photo-edit-button"><img src="/icons/camera.svg" alt="" /><span>Alterar foto</span><input type="file" accept="image/*" data-profile-photo-input /></label>
              </div>
              <h3>Fernando Ernerto</h3><p>Titular • Cliente desde 2018</p>
              <div class="profile-completion"><span><small>Cadastro completo</small><strong>92%</strong></span><div class="progress"><span style="width:92%"></span></div></div>
              <button class="button profile-contact-button" data-route="cadastro" data-scroll-target="cadastro-contatos" type="button"><img src="/icons/contact.svg" alt="" /> Gerenciar contatos</button>
            </aside>
            <form class="panel form-panel" data-profile-form autocomplete="on">
              <div class="panel-title"><div><p class="eyebrow">INFORMAÇÕES</p><h3>Dados pessoais</h3></div></div>
              <div class="form-grid">
                <label class="span-2">Nome completo<input value="Fernando Ernerto" autocomplete="name" required minlength="3" /></label>
                <label>CPF<input value="123.456.789-00" autocomplete="off" disabled /></label>
                <label>Data de nascimento<input value="12/04/1972" autocomplete="bday" required inputmode="numeric" maxlength="10" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" data-birth-date /></label>
                <label>Estado civil<select autocomplete="off"><option>Solteiro(a)</option><option selected>Casado(a)</option><option>União estável</option><option>Divorciado(a)</option><option>Viúvo(a)</option></select></label>
                <label>CEP<input value="06454-000" inputmode="numeric" autocomplete="postal-code" data-address-cep required pattern="[0-9]{5}-?[0-9]{3}" /></label>
                <label class="span-2">Endereço<input value="Al. Rio Negro - Alphaville" autocomplete="address-line1" data-address-field required /><small class="address-autocomplete-status" data-address-status aria-live="polite">Digite o CEP para preencher o endereço automaticamente.</small></label>
                <label>Número da residência<input value="161" inputmode="numeric" autocomplete="address-line2" data-address-number required /></label>
                <label>Cidade<input value="Barueri" autocomplete="address-level2" data-address-city required /></label>
                <label>Estado<input value="SP" maxlength="2" autocomplete="address-level1" data-address-state required pattern="[A-Za-z]{2}" /></label>
              </div>
              <div class="form-actions"><button class="button button-primary" type="submit">Salvar alterações</button></div>
            </form>
          </div>
          <section class="cadastro-contacts section-block" id="cadastro-contatos" aria-labelledby="cadastro-contatos-title">
            <div class="section-heading cadastro-contacts-heading">
              <div><p class="eyebrow">CONTATOS E PREFERÊNCIAS</p><h2 id="cadastro-contatos-title">Onde podemos <strong>falar com você</strong></h2><p class="intro-text">Escolha onde deseja receber boletos, alertas e comunicados.</p></div>
              <button class="button button-primary" type="button" data-add-contact>+ Adicionar contato</button>
            </div>
            <div class="contact-grid" data-contact-grid><article class="panel contact-card" data-contact-card="email"><span class="contact-icon gradient-blue"><img src="/icons/contact.svg" alt="" /></span><div><small>E-MAIL PRINCIPAL</small><h3>fernando.ernerto@email.com</h3><span class="verified" data-contact-status><img src="/icons/check-circle.svg" alt="" /> Verificado</span><p>Comunicados, boletos e alertas importantes.</p></div><button class="text-link" type="button" data-edit-contact="email">Editar</button></article><article class="panel contact-card" data-contact-card="phone"><span class="contact-icon gradient-purple"><img src="/icons/phone.svg" alt="" /></span><div><small>TELEFONE PRINCIPAL</small><h3>(11) 99876-5432</h3><span class="verified" data-contact-status><img src="/icons/check-circle.svg" alt="" /> WhatsApp e SMS</span><p>Canal preferido para confirmações e tokens.</p></div><button class="text-link" type="button" data-edit-contact="phone">Editar</button></article></div>
          </section>
        </section>

        <section class="screen" data-screen="avisos" aria-labelledby="avisos-title">
          <div class="page-intro"><div><button class="page-back" type="button" data-route="inicio"><span aria-hidden="true">←</span> Voltar ao início</button><p class="eyebrow">CENTRAL DE COMUNICAÇÃO</p><h1 id="avisos-title">Avisos e <strong>comunicados</strong></h1><p class="intro-text">Tudo o que importa sobre seu plano e seus serviços.</p></div><button class="button button-ghost" type="button" data-mark-all-read>Marcar tudo como lido</button></div>
          <div class="notice-layout"><div class="filter-chips"><button class="active" type="button" aria-pressed="true" data-notice-filter="all">Todos</button><button type="button" aria-pressed="false" data-notice-filter="notice">Avisos</button><button type="button" aria-pressed="false" data-notice-filter="financeiro">Boletos</button><button type="button" aria-pressed="false" data-notice-filter="bommed">BomMed</button><button type="button" aria-pressed="false" data-notice-filter="instituto">Instituto</button></div><article class="panel notice-list">{communications.map((message) => <button class:list={["notice-item", { unread: message.unread }]} type="button" data-notice-item data-notice-category={message.category}><span class:list={["list-icon", message.category === "financeiro" ? "orange" : message.category === "bommed" ? "blue" : message.title.includes("Telefone") ? "green" : "purple"]}><img src={`/icons/${message.category === "financeiro" ? "wallet" : message.category === "bommed" ? "heart-pulse" : message.title.includes("Telefone") ? "check-circle" : "bell"}.svg`} alt="" /></span><span><small>{message.label}</small><strong>{message.title}</strong><p>{message.message}</p></span><time>{message.time}</time></button>)}<p class="notice-empty" data-notice-empty hidden>Nenhum comunicado nesta categoria.</p></article></div>
        </section>

        <section class="screen" data-screen="plano" aria-labelledby="plano-title">
          <div class="page-intro"><div><button class="page-back" type="button" data-route="inicio"><span aria-hidden="true">←</span> Voltar ao início</button><p class="eyebrow">PLANO E CONTRATO</p><h1 id="plano-title">Seu plano, <strong>sem complicação</strong></h1><p class="intro-text">Consulte vigência, contrato, carteirinha e dependentes.</p></div><span class="status-pill"><i></i> Ativo</span></div>
          <article class="plan-banner"><div><p class="eyebrow light">PLANO ATUAL</p><h2>TOTAL<span>+</span></h2><p>Desde 15 de março de 2018</p></div><div class="plan-stats"><span><small>MENSALIDADE</small><strong>{plan.monthlyAmount}</strong></span><span><small>PRÓX. VENCIMENTO</small><strong>{plan.nextDueDate}</strong></span><span><small>CARTEIRINHA</small><strong>{plan.cardNumber}</strong></span></div></article>
          <div class="action-grid">
            <button class="panel action-card" type="button" data-download="contrato"><span class="list-icon blue"><img src="/icons/download.svg" alt="" /></span><span><strong>2ª via do contrato</strong><small>Documento demonstrativo</small></span><img src="/icons/chevron-right.svg" alt="" /></button>
            <button class="panel action-card" type="button" data-scroll-to="plan-members"><span class="list-icon purple"><img src="/icons/users.svg" alt="" /></span><span><strong>Dependentes (3)</strong><small>João, Ana e Lucas</small></span><img src="/icons/chevron-right.svg" alt="" /></button>
            <button class="panel action-card" type="button" data-scroll-to="plan-coverages"><span class="list-icon orange"><img src="/icons/file-text.svg" alt="" /></span><span><strong>Coberturas</strong><small>Detalhamento por serviço</small></span><img src="/icons/chevron-right.svg" alt="" /></button>
          </div>

          <div class="plan-overview-grid">
            <article class="panel plan-members" id="plan-members">
              <div class="panel-title"><div><p class="eyebrow">BENEFICIÁRIOS</p><h3>Quem está protegido</h3></div><span class="plan-count">4 pessoas</span></div>
              <ul class="member-list">
                <li><span class="member-avatar titular">FE</span><span><strong>Fernando Ernerto</strong><small>Titular • CPF final 00</small></span><span class="soft-badge success">Ativo</span></li>
                <li><span class="member-avatar">JS</span><span><strong>João da Silva</strong><small>Cônjuge • CPF final 18</small></span><span class="soft-badge success">Ativo</span></li>
                <li><span class="member-avatar">AS</span><span><strong>Ana da Silva</strong><small>Filha • 17 anos</small></span><span class="soft-badge success">Ativo</span></li>
                <li><span class="member-avatar">LS</span><span><strong>Lucas da Silva</strong><small>Filho • 12 anos</small></span><span class="soft-badge success">Ativo</span></li>
              </ul>
              <button class="text-link" type="button" data-toast="Em breve: a gestão de beneficiários estará disponível no app">Gerenciar beneficiários →</button>
            </article>

            <article class="panel plan-coverages" id="plan-coverages">
              <div class="panel-title"><div><p class="eyebrow">COBERTURAS</p><h3>Benefícios incluídos</h3></div><span class="soft-badge success">Plano completo</span></div>
              <div class="coverage-grid">
                <div><span class="coverage-icon blue"><img src="/icons/umbrella.svg" alt="" /></span><strong>Assistência familiar</strong><small>Atendimento 24 horas</small></div>
