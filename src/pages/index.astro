    const openNotice = item => { item.classList.remove('unread'); syncUnreadCount(); const category = item.querySelector('small').textContent; const title = item.querySelector('strong').textContent; const message = item.querySelector('p').textContent; openDialog({ eyebrow: category, title, description: message, fields: '<div class="dialog-information"><strong>Mensagem recebida</strong><p>Este comunicado foi marcado como lido e permanece disponível na sua central.</p></div>', submitLabel: 'Entendi', hideCancel: true, onSubmit: () => {} }); };
    noticeItems.forEach(item => item.addEventListener('click', () => openNotice(item)));
    document.querySelectorAll('[data-notice-filter]').forEach(button => button.addEventListener('click', () => { const category = button.dataset.noticeFilter; document.querySelectorAll('[data-notice-filter]').forEach(item => { item.classList.toggle('active', item === button); item.setAttribute('aria-pressed', String(item === button)); }); let visible = 0; noticeItems.forEach(item => { const match = category === 'all' || item.dataset.noticeCategory === category; item.hidden = !match; if (match) visible += 1; }); noticeEmpty.hidden = visible > 0; }));
    document.querySelector('[data-mark-all-read]')?.addEventListener('click', () => { noticeItems.forEach(item => item.classList.remove('unread')); syncUnreadCount(); showToast('Todos os comunicados foram marcados como lidos'); });
    syncUnreadCount();

    const downloadDocuments = {
      contrato: ['contrato-bom-pastor.txt', 'GRUPO BOM PASTOR\nContrato BP-2018-0315-248197\nPlano TOTAL+\nTitular: Fernando Ernerto\nVigência contínua desde 15/03/2018.'],
      coberturas: ['coberturas-total-plus.txt', 'COBERTURAS TOTAL+\nAssistência familiar 24 horas\nBomMed\nApoio emocional\nCentral exclusiva.'],
      boleto: ['boleto-outubro-2026.txt', 'FATURA OUTUBRO 2026\nValor: R$ 79,90\nVencimento: 10/10/2026\nLinha digitável: 23793.38128 60082.118504 04074.951009 1 98770000007990'],
      extrato: ['extrato-2026.txt', 'EXTRATO 2026\nSET 2026 — R$ 79,90 — Pix — Confirmado\nAGO 2026 — R$ 79,90 — Boleto — Confirmado\nJUL 2026 — R$ 79,90 — Pix — Confirmado'],
      guia: ['guia-bommed.txt', 'GUIA BOMMED\nBeneficiário: Fernando Ernerto\nStatus: autorizada\nApresente este documento no atendimento.']
    };
    document.querySelectorAll('[data-download]').forEach(button => button.addEventListener('click', () => {
      let [filename, contents] = downloadDocuments[button.dataset.download] || [];
      if (button.dataset.download === 'guia' && typeof generatedGuide !== 'undefined') contents = `GUIA BOMMED\n${generatedGuide.id}\nBeneficiário: ${generatedGuide.beneficiary}\n${generatedGuide.category}: ${generatedGuide.specialty}\n${generatedGuide.professional || 'Profissional definido na guia'}\nStatus: autorizada`;
      if (!filename || !contents) { showToast('Documento indisponível'); return; }
      const url = URL.createObjectURL(new Blob([contents], { type: 'text/plain;charset=utf-8' }));
      const link = document.createElement('a'); link.href = url; link.download = filename; link.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000); showToast('Documento baixado');
    }));
    document.querySelectorAll('[data-scroll-to]').forEach(button => button.addEventListener('click', () => document.getElementById(button.dataset.scrollTo)?.scrollIntoView({ behavior: 'smooth', block: 'start' })));
    const copyText = async (text, label = 'Código') => {
      try { await navigator.clipboard.writeText(text); showToast(`${label} copiado`); }
      catch {
        openDialog({ eyebrow: 'COPIAR', title: label, description: 'Não foi possível copiar automaticamente. Selecione o texto abaixo e copie manualmente.', fields: `<label class="span-2">${escapeHtml(label)}<textarea readonly rows="3" data-copy-fallback>${escapeHtml(text)}</textarea></label>`, submitLabel: 'Fechar', hideCancel: true, onOpen: root => { const area = root.querySelector('[data-copy-fallback]'); requestAnimationFrame(() => { area.focus(); area.select(); }); }, onSubmit: () => {} });
      }
    };
    document.querySelectorAll('[data-copy]').forEach(button => button.addEventListener('click', () => copyText(button.dataset.copy, button.dataset.copyLabel || 'Código')));
    document.querySelectorAll('[data-toast]').forEach(button => button.addEventListener('click', () => showToast(button.dataset.toast)));
    const brazilStates = new Set(['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO']);
    const profileForm = document.querySelector('[data-profile-form]');
    const birthInput = profileForm?.querySelector('[data-birth-date]');
    const stateInput = profileForm?.querySelector('[data-address-state]');
    birthInput?.addEventListener('input', () => { birthInput.value = maskDate(birthInput.value); birthInput.setCustomValidity(''); });
    stateInput?.addEventListener('input', () => { stateInput.value = stateInput.value.toLocaleUpperCase('pt-BR'); stateInput.setCustomValidity(''); });
    profileForm?.querySelectorAll('input[required]').forEach(input => input.addEventListener('input', () => { if (input !== addressCep) input.setCustomValidity(''); }));
    profileForm?.addEventListener('submit', event => {
      event.preventDefault();
      profileForm.querySelectorAll('input[required]').forEach(input => { if (input !== addressCep && !input.value.trim()) input.setCustomValidity('Preencha este campo.'); });
      if (birthInput && !parseBirthDate(birthInput.value)) birthInput.setCustomValidity('Informe uma data de nascimento válida (DD/MM/AAAA).');
      if (stateInput && !brazilStates.has(stateInput.value.trim().toUpperCase())) stateInput.setCustomValidity('Informe uma UF válida, ex.: SP.');
      if (!profileForm.reportValidity()) return;
      showToast('Alterações salvas nesta demonstração');
    });
    const supportForm = document.querySelector('[data-support-form]');
    supportForm?.addEventListener('submit', event => {
      event.preventDefault();
      const data = new FormData(supportForm);
      const protocol = `AP-${today.getFullYear()}-${String(Math.floor(Math.random() * 90000) + 10000)}`;
      openDialog({ eyebrow: 'INSTITUTO DO LUTO', title: 'Protocolo aberto', description: 'Guarde este número. Nossa equipe retorna em até 24 horas úteis.', fields: `<div class="dialog-information"><strong>${escapeHtml(protocol)}</strong><p>${escapeHtml(data.get('apoio'))}<br />Para: ${escapeHtml(data.get('beneficiario'))}</p></div>`, submitLabel: 'Entendi', hideCancel: true, onSubmit: () => {} });
      supportForm.reset();
    });
    document.querySelectorAll('[data-show-login]').forEach(button => button.addEventListener('click', () => {
      profilePopover.hidden = true;
      profileButton.setAttribute('aria-expanded', 'false');
      isAuthenticated = false;
      sessionStorage.removeItem('bp-master-authenticated');
      document.querySelector('[data-login-form]').reset();
      document.querySelector('[data-login-error]').hidden = true;
      showLogin(true);
    }));
    const passwordInput = document.querySelector('[data-password]');
    document.querySelector('[data-password-toggle]')?.addEventListener('click', event => {
      if (!passwordInput) return;
      const wasVisible = passwordInput.type === 'text';
      passwordInput.type = wasVisible ? 'password' : 'text';
      event.currentTarget.setAttribute('aria-label', wasVisible ? 'Mostrar senha' : 'Ocultar senha');
      event.currentTarget.setAttribute('aria-pressed', String(!wasVisible));
      const icon = event.currentTarget.querySelector('img');
      if (icon) icon.src = wasVisible ? '/icons/eye-off.svg' : '/icons/eye.svg';
    });
    const loginForm = document.querySelector('[data-login-form]');
    const loginUser = document.querySelector('[data-login-user]');
    const loginError = document.querySelector('[data-login-error]');
    const loginSubmit = document.querySelector('[data-login-submit]');
    const clearLoginError = () => { loginError.hidden = true; loginError.textContent = ''; loginUser.removeAttribute('aria-invalid'); passwordInput.removeAttribute('aria-invalid'); };
    loginUser.addEventListener('input', clearLoginError);
    passwordInput.addEventListener('input', clearLoginError);
    loginForm.addEventListener('submit', event => {
      event.preventDefault();
      clearLoginError();
      const validCredentials = loginUser.value.trim().toLocaleLowerCase('pt-BR') === 'teste' && passwordInput.value === '1234';
      if (!validCredentials) {
        loginError.textContent = 'Usuário ou senha incorretos. Confira os dados e tente novamente.';
        loginError.hidden = false;
        loginUser.setAttribute('aria-invalid', 'true');
        passwordInput.setAttribute('aria-invalid', 'true');
        loginUser.focus();
        return;
      }
      loginSubmit.disabled = true;
      loginSubmit.textContent = 'Entrando…';
      window.setTimeout(() => {
        isAuthenticated = true;
        sessionStorage.setItem('bp-master-authenticated', 'true');
        hideLogin();
        loginSubmit.disabled = false;
        loginSubmit.textContent = 'Entrar';
        history.replaceState({ route: 'inicio' }, '', '#inicio');
        showToast('Bem-vindo de volta, Fernando');
        navigate('inicio', false);
      }, 450);
    });
    document.querySelectorAll('[data-account-flow]').forEach(button => button.addEventListener('click', () => {
      const firstAccess = button.dataset.accountFlow === 'first-access';
      openDialog({ eyebrow: 'ACESSO SEGURO', title: firstAccess ? 'Primeiro acesso' : 'Recuperar senha', description: firstAccess ? 'Confirme seus dados para ativar a sua conta.' : 'Enviaremos as instruções para o contato cadastrado.', fields: `<label${firstAccess ? '' : ' class="span-2"'}>CPF<input name="cpf" required inputmode="numeric" maxlength="14" placeholder="000.000.000-00" data-cpf-input /></label>${firstAccess ? '<label>Data de nascimento<input name="birth" required placeholder="DD/MM/AAAA" inputmode="numeric" maxlength="10" data-date-input /></label>' : ''}`, submitLabel: firstAccess ? 'Continuar cadastro' : 'Enviar instruções', onOpen: bindCpfInputs, onSubmit: form => {
        const cpfInput = dialogFields.querySelector('[data-cpf-input]');
        if (!isValidCpf(form.get('cpf'))) { cpfInput.setCustomValidity('CPF inválido. Confira os números.'); cpfInput.reportValidity(); return false; }
        if (firstAccess) { const birth = dialogFields.querySelector('[data-date-input]'); if (!parseBirthDate(form.get('birth'))) { birth.setCustomValidity('Data inválida.'); birth.reportValidity(); return false; } }
        showToast(firstAccess ? 'Dados validados. Continue pelo link enviado' : 'Se o CPF estiver cadastrado, enviaremos as instruções ao contato principal');
      } });
    }));
    document.querySelector('[data-focus-support]')?.addEventListener('click', () => document.querySelector('.support-form textarea')?.focus());
    let generatedGuide = { category: 'Consulta', specialty: 'Cardiologia', professional: 'Dr. Paulo Andrade', beneficiary: 'Fernando Ernerto', id: 'BP-2026-0918' };
    const nextGuideId = () => `BP-${today.getFullYear()}-${String(Math.floor(Math.random() * 9000) + 1000)}`;
    document.querySelector('[data-open-guide]')?.addEventListener('click', () => openDialog({ eyebrow: 'GUIA BOMMED', title: 'Guia autorizada', description: `Documento ${generatedGuide.id} pronto para apresentação no atendimento.`, fields: `<div class="dialog-information"><strong>${escapeHtml(generatedGuide.beneficiary)}</strong><p>${escapeHtml(generatedGuide.category)} • ${escapeHtml(generatedGuide.specialty)}<br />${escapeHtml(generatedGuide.professional || 'Profissional definido na guia')}<br />Desconto de até 35%</p></div>`, submitLabel: 'Fechar', hideCancel: true, onSubmit: () => {} }));
    document.querySelector('[data-share-guide]')?.addEventListener('click', async () => { const shareData = { title: 'Guia BomMed', text: `${generatedGuide.id}: ${generatedGuide.category} — ${generatedGuide.specialty}, para ${generatedGuide.beneficiary}.` }; try { if (navigator.share) await navigator.share(shareData); else { await navigator.clipboard.writeText(shareData.text); showToast('Resumo da guia copiado para compartilhar'); } } catch (error) { if (error.name !== 'AbortError') showToast('Não foi possível compartilhar agora'); } });
    const financeTabs = [...document.querySelectorAll('[data-finance-tab]')];
    const financeViews = [...document.querySelectorAll('[data-finance-view]')];
    const selectFinanceTab = (tab, focus = false) => {
      financeTabs.forEach(item => { const active = item === tab; item.classList.toggle('active', active); item.setAttribute('aria-selected', String(active)); item.tabIndex = active ? 0 : -1; });
      financeViews.forEach(view => view.hidden = view.dataset.financeView !== tab.dataset.financeTab);
      if (focus) tab.focus();
    };
    financeTabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectFinanceTab(tab));
      tab.addEventListener('keydown', event => {
        const keys = { ArrowRight: index + 1, ArrowLeft: index - 1, Home: 0, End: financeTabs.length - 1 };
        if (!(event.key in keys)) return;
        event.preventDefault();
        selectFinanceTab(financeTabs[(keys[event.key] + financeTabs.length) % financeTabs.length], true);
      });
    });
    const guideFlow = document.querySelector('[data-guide-flow]');
    if (guideFlow) {
      const usageHistory = document.querySelector('[data-screen="bommed"] .usage-history');
      const categoryButtons = [...guideFlow.querySelectorAll('[data-guide-category]')];
      const details = guideFlow.querySelector('[data-guide-details]');
      const search = guideFlow.querySelector('[data-guide-search]');
      const suggestions = guideFlow.querySelector('[data-guide-suggestions]');
      const options = [...guideFlow.querySelectorAll('[data-guide-option]')];
      const suggestionsEmpty = guideFlow.querySelector('[data-guide-suggestions-empty]');
      const selection = guideFlow.querySelector('[data-guide-selection]');
      const beneficiary = guideFlow.querySelector('[data-guide-beneficiary]');
      const start = guideFlow.querySelector('[data-guide-step="start"]');
      const confirm = guideFlow.querySelector('[data-guide-confirm]');
      const success = guideFlow.querySelector('[data-guide-success]');
      const state = { category: '', specialty: '', professional: '' };
      const syncGuideDensity = () => {
        const historyIsNear = usageHistory && usageHistory.getBoundingClientRect().top < window.innerHeight * .78;
        const flowIsAtStart = details.hidden && confirm.hidden && success.hidden;
        guideFlow.classList.toggle('is-history-compact', Boolean(historyIsNear && flowIsAtStart));
      };
      window.addEventListener('scroll', syncGuideDensity, { passive: true });
      window.addEventListener('resize', syncGuideDensity);
      requestAnimationFrame(syncGuideDensity);
      const syncSelection = () => {
        guideFlow.querySelector('[data-guide-category-copy]').textContent = state.category.toUpperCase();
        guideFlow.querySelector('[data-guide-specialty]').textContent = state.specialty;
        guideFlow.querySelector('[data-guide-professional]').textContent = state.professional || 'Profissional definido na guia';
        guideFlow.querySelector('[data-guide-beneficiary-copy]').textContent = beneficiary.value;
      };
      categoryButtons.forEach(button => button.addEventListener('click', () => {
        guideFlow.classList.remove('is-history-compact');
        state.category = button.dataset.guideCategory;
        categoryButtons.forEach(item => item.classList.toggle('active', item === button));
        details.hidden = false;
        selection.hidden = true;
        state.specialty = ''; state.professional = '';
        suggestions.hidden = true;
        search.value = '';
        search.placeholder = state.category === 'Consulta' ? 'Busque por especialidade ou profissional' : `Busque por ${state.category.toLowerCase()}`;
        window.setTimeout(() => search.focus(), 180);
      }));
      const filterSuggestions = () => {
        const query = normalizeText(search.value);
        let visibleCount = 0;
        options.forEach(option => {
          const visible = option.dataset.category === state.category && (!query || normalizeText(option.textContent).includes(query));
          option.hidden = !visible;
          if (visible) visibleCount += 1;
        });
        suggestionsEmpty.hidden = visibleCount > 0;
        suggestions.hidden = false;
        search.setAttribute('aria-expanded', 'true');
      };
      search.addEventListener('focus', filterSuggestions);
      search.addEventListener('input', filterSuggestions);
      options.forEach(option => option.addEventListener('click', () => {
        state.specialty = option.dataset.specialty;
        state.professional = option.dataset.professional;
        search.value = state.professional || state.specialty;
        suggestions.hidden = true;
        search.setAttribute('aria-expanded', 'false');
        syncSelection();
        selection.hidden = false;
      }));
      beneficiary.addEventListener('change', syncSelection);
      guideFlow.querySelector('[data-guide-review]').addEventListener('click', () => {
        if (!state.category || !state.specialty) { showToast('Escolha o atendimento antes de continuar'); search.focus(); return; }
        guideFlow.querySelector('[data-confirm-category]').textContent = state.category;
        guideFlow.querySelector('[data-confirm-specialty]').textContent = state.specialty;
        guideFlow.querySelector('[data-confirm-professional]').textContent = state.professional || 'Profissional definido na guia';
        guideFlow.querySelector('[data-confirm-beneficiary]').textContent = beneficiary.value;
        start.hidden = true; details.hidden = true; confirm.hidden = false;
      });
      guideFlow.querySelector('[data-guide-back]').addEventListener('click', () => { confirm.hidden = true; start.hidden = false; details.hidden = false; });
      guideFlow.querySelector('[data-guide-generate]').addEventListener('click', () => {
        generatedGuide = { ...state, beneficiary: beneficiary.value.replace(' (Titular)', ''), id: nextGuideId() };
        confirm.hidden = true;
        success.hidden = false;
        const list = document.querySelector('[data-guide-history-list]');
        const item = document.createElement('li');
        item.innerHTML = `<button type="button" data-guide-history><time>${shortDate(today)}</time><span><strong>${escapeHtml(generatedGuide.specialty)}</strong><small>${escapeHtml(generatedGuide.professional || 'Profissional definido na guia')} • ${escapeHtml(generatedGuide.beneficiary)}</small></span><span class="soft-badge info">Autorizada</span></button><div hidden><b>Guia ${escapeHtml(generatedGuide.id)}</b><span>${escapeHtml(generatedGuide.beneficiary)} • desconto de até 35%</span></div>`;
        list?.prepend(item);
        const historyButton = item.querySelector('[data-guide-history]');
        historyButton?.addEventListener('click', () => { const detail = item.querySelector('div'); const open = detail.hidden; detail.hidden = !open; item.classList.toggle('open', open); });
        showToast('Guia BomMed gerada com sucesso');
      });
      guideFlow.querySelector('[data-guide-new]').addEventListener('click', () => {
        success.hidden = true; start.hidden = false; details.hidden = true; selection.hidden = true; suggestions.hidden = true; suggestionsEmpty.hidden = true;
        state.category = ''; state.specialty = ''; state.professional = ''; search.value = ''; search.setAttribute('aria-expanded', 'false');
        categoryButtons.forEach(item => item.classList.remove('active'));
        requestAnimationFrame(syncGuideDensity);
      });
      document.addEventListener('click', event => {
        if (!guideFlow.querySelector('.guide-search-block').contains(event.target)) { suggestions.hidden = true; search.setAttribute('aria-expanded', 'false'); }
      });
    }
    document.querySelectorAll('[data-guide-history]').forEach(button => button.addEventListener('click', () => {
      const item = button.closest('li'); const detail = item.querySelector('div'); const open = detail.hidden;
      detail.hidden = !open; item.classList.toggle('open', open);
    }));
    const guideHistorySearch = document.querySelector('[data-guide-history-search]');
    const guideHistoryEmpty = document.querySelector('[data-guide-history-empty]');
    guideHistorySearch?.addEventListener('input', () => {
      const query = normalizeText(guideHistorySearch.value);
      let visibleItems = 0;
      document.querySelectorAll('[data-guide-history-list] > li').forEach(item => {
        const visible = !query || normalizeText(item.textContent).includes(query);
        item.hidden = !visible;
        if (visible) visibleItems += 1;
      });
      guideHistoryEmpty.hidden = visibleItems > 0;
    });
    const walletScreen = document.querySelector('[data-screen="carteirinha"]');
    const walletBeneficiary = walletScreen?.querySelector('[data-wallet-beneficiary]');
    const walletPeople = Object.fromEntries((mockData.beneficiaries || []).map(person => [person.id, { name: person.name.toLocaleUpperCase('pt-BR'), role: person.role.toLocaleUpperCase('pt-BR'), number: person.number, code: person.benefitCode }]));
    const updateWalletBeneficiary = () => {
      if (!walletScreen || !walletBeneficiary) return;
      const person = walletPeople[walletBeneficiary.value];
      if (!person) return;
      walletScreen.querySelector('[data-wallet-name]').textContent = person.name;
      walletScreen.querySelector('[data-wallet-role]').textContent = person.role;
      walletScreen.querySelector('[data-wallet-number]').textContent = person.number;
      walletScreen.querySelector('[data-wallet-benefit-code]').textContent = person.code;
    };
    const applyWalletStatus = () => {
      if (!walletScreen) return;
      const overdue = walletScreen.dataset.cardStatus === 'overdue';
      walletScreen.classList.toggle('is-overdue', overdue);
      walletScreen.querySelectorAll('[data-active-only]').forEach(element => element.hidden = overdue);
      walletScreen.querySelectorAll('[data-overdue-only]').forEach(element => element.hidden = !overdue);
    };
    walletBeneficiary?.addEventListener('change', updateWalletBeneficiary);
    walletScreen && new MutationObserver(applyWalletStatus).observe(walletScreen, { attributes: true, attributeFilter: ['data-card-status'] });
    walletScreen?.querySelector('[data-wallet-copy]')?.addEventListener('click', () => {
      const code = walletScreen.querySelector('[data-wallet-benefit-code]').textContent.trim();
      copyText(code, 'Código do benefício');
    });
    updateWalletBeneficiary();
    applyWalletStatus();
    const initialRoute = location.hash.slice(1);
    if (!isAuthenticated) showLogin(true);
    else {
      hideLogin();
      if (initialRoute === 'contatos') navigate('cadastro', false, 'cadastro-contatos');
      else {
        const safeRoute = individualRoutes.has(initialRoute) ? initialRoute : 'inicio';
        if (safeRoute !== initialRoute) history.replaceState({ route: safeRoute }, '', `#${safeRoute}`);
        navigate(safeRoute, false);
      }
    }
    window.addEventListener('popstate', () => {
      if (!isAuthenticated) { showLogin(true); return; }
      const route = location.hash.slice(1);
      if (route === 'contatos') { navigate('cadastro', false, 'cadastro-contatos'); return; }
      const safeRoute = individualRoutes.has(route) ? route : 'inicio';
      if (safeRoute !== route) history.replaceState({ route: safeRoute }, '', `#${safeRoute}`);
      navigate(safeRoute, false);
    });
    requestAnimationFrame(() => document.querySelectorAll('.reveal').forEach(el => el.classList.add('visible')));
  </script>
</Layout>
