  <script is:inline>
    const screens = [...document.querySelectorAll('[data-screen]')];
    const routeButtons = [...document.querySelectorAll('[data-route]')];
    const drawer = document.querySelector('[data-drawer]');
    const toast = document.querySelector('[data-toast-box]');
    let toastTimer;
    function showToast(message) { toast.querySelector('span').textContent = message; toast.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.remove('show'), 2600); }
    function navigate(route, updateHash = true, scrollTarget = '') {
      const target = document.querySelector(`[data-screen="${route}"]`); if (!target) return;
      screens.forEach(screen => screen.classList.toggle('active', screen === target));
      routeButtons.forEach(button => button.classList.toggle('active', button.dataset.route === route));
      drawer.classList.remove('open'); drawer.setAttribute('aria-hidden', 'true'); document.body.classList.remove('menu-open');
      if (updateHash) history.replaceState(null, '', `#${route}`);
      const section = scrollTarget && document.getElementById(scrollTarget);
      if (section) requestAnimationFrame(() => section.scrollIntoView({ behavior: 'smooth', block: 'start' }));
      else window.scrollTo({ top: 0, behavior: 'smooth' });
      requestAnimationFrame(() => target.querySelectorAll('.reveal').forEach(el => el.classList.add('visible')));
    }
    routeButtons.forEach(button => button.addEventListener('click', event => { event.preventDefault(); navigate(button.dataset.route, true, button.dataset.scrollTarget); const accountMenu = document.querySelector('[data-profile-popover]'); if (accountMenu) accountMenu.hidden = true; document.querySelector('[data-profile-button]')?.setAttribute('aria-expanded', 'false'); }));
    document.querySelectorAll('[data-menu-open]').forEach(button => button.addEventListener('click', () => { drawer.classList.add('open'); drawer.setAttribute('aria-hidden', 'false'); document.body.classList.add('menu-open'); }));
    document.querySelectorAll('[data-menu-close]').forEach(button => button.addEventListener('click', () => { drawer.classList.remove('open'); drawer.setAttribute('aria-hidden', 'true'); document.body.classList.remove('menu-open'); }));
    const searchButton = document.querySelector('[data-search-button]'); const globalSearch = document.querySelector('[data-global-search]');
    const searchInput = globalSearch.querySelector('input');
    const openSearch = () => {
      globalSearch.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => {
        globalSearch.classList.add('open');
        searchButton.setAttribute('aria-expanded', 'true');
        searchInput.focus();
      }));
    };
    const closeSearch = () => {
      globalSearch.classList.remove('open');
      searchButton.setAttribute('aria-expanded', 'false');
      const finishClose = () => { if (!globalSearch.classList.contains('open')) globalSearch.hidden = true; };
      globalSearch.addEventListener('transitionend', finishClose, { once: true });
      window.setTimeout(finishClose, 450);
    };
    searchButton.setAttribute('aria-expanded', 'false');
    searchButton.addEventListener('click', openSearch);
    document.querySelector('[data-search-close]').addEventListener('click', closeSearch);
    const profileButton = document.querySelector('[data-profile-button]'); const profilePopover = document.querySelector('[data-profile-popover]');
    profileButton.addEventListener('click', () => { const open = profilePopover.hasAttribute('hidden'); profilePopover.toggleAttribute('hidden', !open); profileButton.setAttribute('aria-expanded', String(open)); });
    const accessibilityButton = document.querySelector('[data-accessibility-button]');
    const accessibilityPanel = document.querySelector('[data-accessibility-panel]');
    const accessibilityBackdrop = document.querySelector('[data-accessibility-backdrop]');
    const accessibilityClose = document.querySelector('[data-accessibility-close]');
    const fontStatus = document.querySelector('[data-font-scale-status]');
    const fontActions = [...document.querySelectorAll('[data-font-action]')];
    const fontScales = [0.9, 1, 1.1, 1.2, 1.3];
    let fontScaleIndex = Math.max(0, fontScales.indexOf(Number(document.documentElement.dataset.fontLevel || 1.1)));
    let accessibilityLastFocus = null;
    const fontLevelLabel = index => index === 0 ? 'Texto reduzido' : index === 1 ? 'Tamanho padrão' : `Texto aumentado +${index - 1}`;
    const applyFontScale = (index, persist = true) => {
      fontScaleIndex = Math.max(0, Math.min(fontScales.length - 1, index));
      const scale = fontScales[fontScaleIndex];
      document.documentElement.style.setProperty('--font-scale', String(scale));
      document.documentElement.dataset.fontLevel = String(scale);
      fontStatus.textContent = fontLevelLabel(fontScaleIndex);
      const decrease = document.querySelector('[data-font-action="decrease"]');
      const standard = document.querySelector('[data-font-action="default"]');
      const increase = document.querySelector('[data-font-action="increase"]');
      decrease.disabled = fontScaleIndex === 0;
      increase.disabled = fontScaleIndex === fontScales.length - 1;
      standard.setAttribute('aria-pressed', String(fontScaleIndex === 1));
      if (persist) { try { localStorage.setItem('accessibility-font-scale', String(scale)); } catch {} }
    };
    const openAccessibility = () => {
      accessibilityLastFocus = document.activeElement;
      accessibilityPanel.hidden = false;
      accessibilityBackdrop.hidden = false;
      accessibilityButton.setAttribute('aria-expanded', 'true');
      document.body.classList.add('accessibility-open');
      accessibilityClose.focus();
    };
    const closeAccessibility = () => {
      if (accessibilityPanel.hidden) return;
      accessibilityPanel.hidden = true;
      accessibilityBackdrop.hidden = true;
      accessibilityButton.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('accessibility-open');
      accessibilityButton.focus();
    };
    accessibilityButton.addEventListener('click', () => accessibilityPanel.hidden ? openAccessibility() : closeAccessibility());
    accessibilityClose.addEventListener('click', closeAccessibility);
    accessibilityBackdrop.addEventListener('click', closeAccessibility);
    fontActions.forEach(button => button.addEventListener('click', () => {
      if (button.dataset.fontAction === 'decrease') applyFontScale(fontScaleIndex - 1);
      if (button.dataset.fontAction === 'default') applyFontScale(1);
      if (button.dataset.fontAction === 'increase') applyFontScale(fontScaleIndex + 1);
    }));
    document.querySelector('[data-font-reset]').addEventListener('click', () => applyFontScale(1));
    accessibilityPanel.addEventListener('keydown', event => {
      if (event.key === 'Escape') { event.preventDefault(); closeAccessibility(); return; }
      if (event.key !== 'Tab') return;
      const focusable = [...accessibilityPanel.querySelectorAll('button:not(:disabled), [href], input:not(:disabled), select:not(:disabled), [tabindex]:not([tabindex="-1"])')];
      const first = focusable[0]; const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && !accessibilityPanel.hidden) closeAccessibility(); });
    applyFontScale(fontScaleIndex, false);
    const profilePhotoInput = document.querySelector('[data-profile-photo-input]');
    let profilePhotoUrl = '';
    profilePhotoInput?.addEventListener('change', () => {
      const file = profilePhotoInput.files?.[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) { showToast('Selecione uma imagem válida'); return; }
      if (profilePhotoUrl) URL.revokeObjectURL(profilePhotoUrl);
      profilePhotoUrl = URL.createObjectURL(file);
      document.querySelectorAll('.large-avatar,.avatar').forEach(avatar => {
        avatar.classList.add('has-photo');
        avatar.style.setProperty('--profile-photo', `url("${profilePhotoUrl}")`);
        avatar.textContent = '';
      });
      showToast('Foto de perfil atualizada');
    });
    const addressCep = document.querySelector('[data-address-cep]');
    const addressField = document.querySelector('[data-address-field]');
    const addressCity = document.querySelector('[data-address-city]');
    const addressState = document.querySelector('[data-address-state]');
    const addressStatus = document.querySelector('[data-address-status]');
    const localAddresses = { '06454000': { street: 'Al. Rio Negro - Alphaville', city: 'Barueri', state: 'SP' } };
    let cepLookupController;
    const completeAddress = async (announce = true) => {
      const cep = addressCep?.value.replace(/\D/g, '') || '';
      if (cep.length !== 8) { addressStatus.textContent = 'Digite um CEP válido com 8 números.'; return; }
      if (localAddresses[cep]) {
        const address = localAddresses[cep];
        addressField.value = address.street;
        addressCity.value = address.city;
        addressState.value = address.state;
        addressStatus.textContent = 'Endereço preenchido automaticamente pelo CEP.';
        if (announce) showToast('Endereço localizado pelo CEP');
        return;
      }
      cepLookupController?.abort();
      cepLookupController = new AbortController();
      addressStatus.textContent = 'Buscando endereço pelo CEP…';
      try {
        const response = await fetch(`https://viacep.com.br/ws/${cep}/json/`, { signal: cepLookupController.signal });
        if (!response.ok) throw new Error('Falha na consulta');
        const data = await response.json();
        if (data.erro) { addressStatus.textContent = 'CEP não encontrado. Confira os números.'; return; }
        addressField.value = [data.logradouro, data.bairro].filter(Boolean).join(' - ');
        addressCity.value = data.localidade || '';
        addressState.value = data.uf || '';
        addressStatus.textContent = 'Endereço preenchido automaticamente. Complete o número.';
        if (announce) showToast('Endereço localizado pelo CEP');
      } catch (error) {
        if (error.name !== 'AbortError') addressStatus.textContent = 'Não foi possível consultar agora. Digite o endereço manualmente.';
      }
    };
    addressCep?.addEventListener('input', () => {
      const digits = addressCep.value.replace(/\D/g, '').slice(0, 8);
      addressCep.value = digits.replace(/^(\d{5})(\d)/, '$1-$2');
      if (digits.length === 8) completeAddress();
    });
    addressCep?.addEventListener('blur', () => completeAddress(false));
    completeAddress(false);
    document.querySelectorAll('[data-copy]').forEach(button => button.addEventListener('click', async () => { try { await navigator.clipboard.writeText(button.dataset.copy); showToast('Código copiado com sucesso'); } catch { showToast('Código pronto para copiar'); } }));
    document.querySelectorAll('[data-toast]').forEach(button => button.addEventListener('click', () => showToast(button.dataset.toast)));
    document.querySelectorAll('[data-demo-form]').forEach(form => form.addEventListener('submit', event => { event.preventDefault(); showToast('Informações salvas com sucesso'); }));
    const login = document.querySelector('[data-login]'); document.querySelectorAll('[data-show-login]').forEach(button => button.addEventListener('click', () => { profilePopover.hidden = true; login.hidden = false; }));
    const passwordInput = document.querySelector('[data-password]');
    document.querySelector('[data-password-toggle]')?.addEventListener('click', event => { const visible = passwordInput.type === 'text'; passwordInput.type = visible ? 'password' : 'text'; event.currentTarget.setAttribute('aria-label', visible ? 'Mostrar senha' : 'Ocultar senha'); });
    document.querySelector('[data-login-form]').addEventListener('submit', event => { event.preventDefault(); login.hidden = true; showToast('Bem-vindo de volta, Fernando'); navigate('inicio'); });
    document.querySelector('[data-focus-support]')?.addEventListener('click', () => document.querySelector('.support-form textarea')?.focus());
    const financeTabs = [...document.querySelectorAll('[data-finance-tab]')];
    const financeViews = [...document.querySelectorAll('[data-finance-view]')];
    financeTabs.forEach(tab => tab.addEventListener('click', () => {
      financeTabs.forEach(item => { const active = item === tab; item.classList.toggle('active', active); item.setAttribute('aria-selected', String(active)); });
      financeViews.forEach(view => view.hidden = view.dataset.financeView !== tab.dataset.financeTab);
    }));
    const guideFlow = document.querySelector('[data-guide-flow]');
    if (guideFlow) {
      const categoryButtons = [...guideFlow.querySelectorAll('[data-guide-category]')];
      const details = guideFlow.querySelector('[data-guide-details]');
      const search = guideFlow.querySelector('[data-guide-search]');
      const suggestions = guideFlow.querySelector('[data-guide-suggestions]');
      const options = [...guideFlow.querySelectorAll('[data-guide-option]')];
      const selection = guideFlow.querySelector('[data-guide-selection]');
      const beneficiary = guideFlow.querySelector('[data-guide-beneficiary]');
      const start = guideFlow.querySelector('[data-guide-step="start"]');
      const confirm = guideFlow.querySelector('[data-guide-confirm]');
      const success = guideFlow.querySelector('[data-guide-success]');
      const state = { category: '', specialty: '', professional: '' };
      const syncSelection = () => {
        guideFlow.querySelector('[data-guide-category-copy]').textContent = state.category.toUpperCase();
        guideFlow.querySelector('[data-guide-specialty]').textContent = state.specialty;
        guideFlow.querySelector('[data-guide-professional]').textContent = state.professional || 'Profissional definido na guia';
        guideFlow.querySelector('[data-guide-beneficiary-copy]').textContent = beneficiary.value;
      };
      categoryButtons.forEach(button => button.addEventListener('click', () => {
        state.category = button.dataset.guideCategory;
        categoryButtons.forEach(item => item.classList.toggle('active', item === button));
        details.hidden = false;
        selection.hidden = true;
        search.value = '';
        search.placeholder = state.category === 'Consulta' ? 'Busque por especialidade ou profissional' : `Busque por ${state.category.toLowerCase()}`;
        window.setTimeout(() => search.focus(), 180);
      }));
      const filterSuggestions = () => {
        const query = search.value.trim().toLocaleLowerCase('pt-BR');
        let visibleCount = 0;
        options.forEach(option => {
          const visible = !query || option.textContent.toLocaleLowerCase('pt-BR').includes(query);
          option.hidden = !visible;
          if (visible) visibleCount += 1;
        });
        suggestions.hidden = visibleCount === 0;
        search.setAttribute('aria-expanded', String(visibleCount > 0));
      };
      search.addEventListener('focus', filterSuggestions);
      search.addEventListener('input', filterSuggestions);
      options.forEach(option => option.addEventListener('click', () => {
        state.specialty = option.dataset.specialty;
        state.professional = option.dataset.professional;
        search.value = state.professional || state.specialty;
        suggestions.hidden = true;
        search.setAttribute('aria-expanded', 'false');
        syncSelection();
        selection.hidden = false;
      }));
      beneficiary.addEventListener('change', syncSelection);
      guideFlow.querySelector('[data-guide-review]').addEventListener('click', () => {
        guideFlow.querySelector('[data-confirm-category]').textContent = state.category;
        guideFlow.querySelector('[data-confirm-specialty]').textContent = state.specialty;
        guideFlow.querySelector('[data-confirm-professional]').textContent = state.professional || 'Profissional definido na guia';
        guideFlow.querySelector('[data-confirm-beneficiary]').textContent = beneficiary.value;
        start.hidden = true; details.hidden = true; confirm.hidden = false;
      });
      guideFlow.querySelector('[data-guide-back]').addEventListener('click', () => { confirm.hidden = true; start.hidden = false; details.hidden = false; });
      guideFlow.querySelector('[data-guide-generate]').addEventListener('click', () => { confirm.hidden = true; success.hidden = false; showToast('Guia BomMed gerada com sucesso'); });
      guideFlow.querySelector('[data-guide-new]').addEventListener('click', () => {
        success.hidden = true; start.hidden = false; details.hidden = true; selection.hidden = true; suggestions.hidden = true;
        state.category = ''; state.specialty = ''; state.professional = ''; search.value = '';
        categoryButtons.forEach(item => item.classList.remove('active'));
      });
      document.addEventListener('click', event => {
        if (!guideFlow.querySelector('.guide-search-block').contains(event.target)) { suggestions.hidden = true; search.setAttribute('aria-expanded', 'false'); }
      });
    }
    document.querySelectorAll('[data-guide-history]').forEach(button => button.addEventListener('click', () => {
      const item = button.closest('li'); const detail = item.querySelector('div'); const open = detail.hidden;
      detail.hidden = !open; item.classList.toggle('open', open);
    }));
    const guideHistorySearch = document.querySelector('[data-guide-history-search]');
    const guideHistoryItems = [...document.querySelectorAll('[data-guide-history-list] > li')];
    const guideHistoryEmpty = document.querySelector('[data-guide-history-empty]');
    guideHistorySearch?.addEventListener('input', () => {
      const query = guideHistorySearch.value.trim().toLocaleLowerCase('pt-BR');
      let visibleItems = 0;
      guideHistoryItems.forEach(item => {
        const visible = !query || item.textContent.toLocaleLowerCase('pt-BR').includes(query);
        item.hidden = !visible;
        if (visible) visibleItems += 1;
      });
      guideHistoryEmpty.hidden = visibleItems > 0;
    });
    const initialRoute = location.hash.slice(1);
    if (initialRoute === 'contatos') navigate('cadastro', false, 'cadastro-contatos');
    else navigate(document.querySelector(`[data-screen="${initialRoute}"]`) ? initialRoute : 'inicio', false);
    requestAnimationFrame(() => document.querySelectorAll('.reveal').forEach(el => el.classList.add('visible')));
  </script>
</Layout>
