    const walletScreen = document.querySelector('[data-screen="carteirinha"]');
    const walletBeneficiary = walletScreen?.querySelector('[data-wallet-beneficiary]');
    const walletPeople = Object.fromEntries((mockData.beneficiaries || []).map(person => [person.id, { name: person.name.toLocaleUpperCase('pt-BR'), role: person.role.toLocaleUpperCase('pt-BR'), number: person.number, code: person.benefitCode }]));
    const updateWalletBeneficiary = () => {
      if (!walletScreen || !walletBeneficiary) return;
      const person = walletPeople[walletBeneficiary.value];
      if (!person) return;
      walletScreen.querySelector('[data-wallet-name]').textContent = person.name;
      walletScreen.querySelector('[data-wallet-role]').textContent = person.role;
      walletScreen.querySelector('[data-wallet-number]').textContent = person.number;
      walletScreen.querySelector('[data-wallet-benefit-code]').textContent = person.code;
    };
    const applyWalletStatus = () => {
      if (!walletScreen) return;
      const overdue = walletScreen.dataset.cardStatus === 'overdue';
      walletScreen.classList.toggle('is-overdue', overdue);
      walletScreen.querySelectorAll('[data-active-only]').forEach(element => element.hidden = overdue);
      walletScreen.querySelectorAll('[data-overdue-only]').forEach(element => element.hidden = !overdue);
    };
    // Palco "Seu plano": status ativo × inadimplente (mock por conta) e espelho na carteirinha.
    const applyPlanStatus = overdue => {
      const stage = document.querySelector('[data-plan-stage]');
      const pending = mockData.plan?.overdue || { late: 0, expired: 0 };
      if (stage) {
        stage.dataset.planStatus = overdue ? 'overdue' : 'active';
        const parts = [];
        if (pending.late) parts.push(`${pending.late} atrasada${pending.late > 1 ? 's' : ''}`);
        if (pending.expired) parts.push(`${pending.expired} expirada${pending.expired > 1 ? 's' : ''}`);
        stage.querySelector('[data-plan-pending-label]').textContent = overdue && parts.length ? parts.join(' · ') : 'Mensalidades em dia';
      }
      const banner = document.querySelector('[data-plan-banner]');
      if (banner) {
        const total = (pending.late || 0) + (pending.expired || 0);
        banner.dataset.planStatus = overdue ? 'overdue' : 'active';
        banner.querySelector('[data-plan-banner-status]').textContent = overdue ? 'Contrato inadimplente' : 'Contrato ativo';
        banner.querySelectorAll('[data-overdue-only]').forEach(el => { el.hidden = !overdue; });
        const stat = banner.querySelector('[data-plan-late]');
        if (stat) stat.textContent = overdue ? `${total} parcelas em atraso` : 'Mensalidades em dia';
      }
      const homeStatus = document.querySelector('[data-home-status]');
      if (homeStatus) { homeStatus.classList.toggle('is-overdue', overdue); homeStatus.querySelector('span').textContent = overdue ? 'Plano inadimplente' : 'Plano ativo'; }
      if (walletScreen) walletScreen.dataset.cardStatus = overdue ? 'overdue' : 'active';
    };
    // Beneficiários (Meu Plano): atualizar contato e gerar código de acesso do dependente (mock).
    const memberById = Object.fromEntries((mockData.beneficiaries || []).map(person => [person.id, person]));
    // Abre/fecha o beneficiário com animação suave (altura + opacidade).
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    document.querySelectorAll('.member-item').forEach(item => {
      const summary = item.querySelector('summary');
      const body = item.querySelector('.member-details');
      let anim = null;
      summary.addEventListener('click', event => {
        if (reduceMotion.matches || !body.animate) return;
        event.preventDefault();
        anim?.cancel();
        const opening = !item.open || item.classList.contains('is-closing');
        const start = item.open ? `${body.getBoundingClientRect().height}px` : '0px';
        if (opening) { item.classList.remove('is-closing'); item.open = true; }
        else item.classList.add('is-closing');
        const end = opening ? `${body.scrollHeight}px` : '0px';
        item.classList.add('is-animating');
        anim = body.animate([{ height: start, paddingTop: opening ? '0px' : '2px', paddingBottom: opening ? '0px' : '16px', opacity: opening ? 0 : 1 }, { height: end, paddingTop: opening ? '2px' : '0px', paddingBottom: opening ? '16px' : '0px', opacity: opening ? 1 : 0 }], { duration: 650, easing: 'cubic-bezier(.22,.61,.36,1)' });
        anim.onfinish = () => { item.classList.remove('is-animating'); if (!opening) { item.open = false; item.classList.remove('is-closing'); } anim = null; };
      });
    });
    // Upgrade de plano (mock): pede contato de um consultor.
    const upgradeById = Object.fromEntries((mockData.upgrades || []).map(offer => [offer.id, offer]));
    document.querySelectorAll('[data-upgrade]').forEach(button => button.addEventListener('click', () => {
      const offer = upgradeById[button.dataset.upgrade]; if (!offer) return;
      openDialog({
        eyebrow: 'UPGRADE DE PLANO', title: offer.name,
        description: `${offer.price} por mês. Um consultor liga para você para confirmar as condições e concluir a contratação.`,
        fields: '<label>Melhor horário para ligarmos<select name="period"><option>Manhã (8h às 12h)</option><option>Tarde (12h às 18h)</option><option>Noite (18h às 20h)</option></select></label>',
        submitLabel: 'Quero contratar',
        onSubmit: data => { const when = { Manhã: 'de manhã', Tarde: 'à tarde', Noite: 'à noite' }[String(data.get('period')).split(' ')[0]] || ''; showToast(`Pedido enviado! Um consultor liga para você ${when}.`); },
      });
    }));
    document.querySelectorAll('[data-member-update]').forEach(button => button.addEventListener('click', () => {
      const person = memberById[button.dataset.memberUpdate]; if (!person) return;
      openDialog({
        eyebrow: 'BENEFICIÁRIO', title: person.name, description: 'Atualize o celular e o e-mail deste beneficiário.',
        fields: '<label>Celular<input name="phone" data-phone-input inputmode="numeric" placeholder="(00) 00000-0000" required /></label><label>E-mail<input name="email" type="email" placeholder="nome@email.com" /></label>',
        onOpen: root => bindCpfInputs(root),
        onSubmit: () => { showToast(`Informações de ${person.name.split(' ')[0]} atualizadas`); },
      });
    }));
    document.querySelectorAll('[data-member-code]').forEach(button => button.addEventListener('click', () => {
      const person = memberById[button.dataset.memberCode]; if (!person) return;
      const code = person.accessCode || `DEP-${String(Math.floor(1000 + Math.random() * 9000))}`;
      person.accessCode = code;
      openDialog({
        eyebrow: 'CÓDIGO DE ACESSO', title: code,
        description: `Entregue este código para ${person.name.split(' ')[0]}. Na tela de entrada, ${person.role === 'Filho' || person.role === 'Filha' ? 'ele(a)' : 'a pessoa'} digita o próprio CPF e depois o código. Vale por 24 horas.`,
        submitLabel: 'Copiar código', hideCancel: true,
        onSubmit: () => { navigator.clipboard?.writeText(code).catch(() => {}); showToast('Código copiado'); },
      });
    }));
    walletBeneficiary?.addEventListener('change', updateWalletBeneficiary);
    walletScreen && new MutationObserver(applyWalletStatus).observe(walletScreen, { attributes: true, attributeFilter: ['data-card-status'] });
    walletScreen?.querySelector('[data-wallet-copy]')?.addEventListener('click', () => {
      const code = walletScreen.querySelector('[data-wallet-benefit-code]').textContent.trim();
      copyText(code, 'Código do benefício');
    });
    updateWalletBeneficiary();
    applyWalletStatus();
    const initialRoute = location.hash.slice(1);
    resetLogin();
    if (!isAuthenticated) showLogin(true);
    else {
      applySession(readSession());
      hideLogin();
      if (initialRoute === 'contatos' && allowedRoutes().has('cadastro')) navigate('cadastro', false, 'cadastro-contatos');
      else {
        const safeRoute = allowedRoutes().has(initialRoute) ? initialRoute : homeRoute();
        if (safeRoute !== initialRoute) history.replaceState({ route: safeRoute }, '', `#${safeRoute}`);
        navigate(safeRoute, false);
      }
    }
    window.addEventListener('popstate', () => {
      if (!isAuthenticated) { showLogin(true); return; }
      const route = location.hash.slice(1);
      if (route === 'contatos' && allowedRoutes().has('cadastro')) { navigate('cadastro', false, 'cadastro-contatos'); return; }
      const safeRoute = allowedRoutes().has(route) ? route : homeRoute();
      if (safeRoute !== route) history.replaceState({ route: safeRoute }, '', `#${safeRoute}`);
      navigate(safeRoute, false);
    });
    requestAnimationFrame(() => document.querySelectorAll('.reveal').forEach(el => el.classList.add('visible')));
  </script>
</Layout>
