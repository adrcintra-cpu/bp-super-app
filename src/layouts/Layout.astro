---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Landingbase", description = "" } = Astro.props;

// Só emite canonical absoluto quando `site` estiver definido no astro.config.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/logos/bompastor-logo-minimalista.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      try {
        const storedScale = Number(localStorage.getItem('accessibility-font-scale'));
        const allowedScales = [0.9, 1, 1.1, 1.2, 1.3];
        const initialScale = allowedScales.includes(storedScale) ? storedScale : 1.1;
        document.documentElement.style.setProperty('--font-scale', String(initialScale));
        document.documentElement.dataset.fontLevel = String(initialScale);
      } catch {}
    </script>

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <slot />
  </body>
</html>
